# Copier ce fichier en .env et adapter si besoin (le .env n'est pas versionné)

# Conteneur Postgres (docker-compose.yml)
POSTGRES_USER=scoring
POSTGRES_PASSWORD=scoring
POSTGRES_DB=scoring
POSTGRES_PORT=5432

# ETL et API en local (lu par pkg/src/config.py). Dans docker-compose, l'URL pointe vers le service "db".
SCORING_DATABASE_URL=postgresql+psycopg://scoring:scoring@localhost:5432/scoring
SCORING_DATA_DIR=data

# Front Streamlit en local (dans docker-compose : http://api:8000)
SCORING_API_URL=http://localhost:8000
